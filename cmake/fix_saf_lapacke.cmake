# The pinned SAF revision passes a CBLAS enum to LAPACKE's char uplo argument.
# Preserve the separate CLAPACK and Accelerate code paths.
set(source "${saf_SOURCE_DIR}/framework/modules/saf_utilities/saf_utility_veclib.c")
file(READ "${source}" original)
set(patched "${original}")
foreach(routine IN ITEMS sposv cposv spotrf cpotrf)
    set(call "LAPACKE_${routine}_work(CblasColMajor, ")
    if(patched MATCHES "LAPACKE_${routine}_work\\(CblasColMajor, CblasUpper,")
        string(REPLACE "${call}CblasUpper," "${call}'U'," patched "${patched}")
    elseif(NOT patched MATCHES "LAPACKE_${routine}_work\\(CblasColMajor, 'U',")
        message(FATAL_ERROR "Unexpected SAF LAPACKE call for ${routine}. Review the compatibility fix.")
    endif()
endforeach()
if(NOT patched STREQUAL original)
    file(WRITE "${source}" "${patched}")
endif()
